index 155cea2..4a10d30 100644
--- a/nextclient/packages/gameplay/crosshair/include/crosshair/crosshair.h
+++ b/nextclient/packages/gameplay/crosshair/include/crosshair/crosshair.h
@@ -85,6 +85,27 @@ namespace crosshair
         return 1024;
     }
 
+    // cl_crosshair_thickness: the line width in screen pixels, whole and within these bounds.
+    inline constexpr int kThicknessMin = 1;
+    inline constexpr int kThicknessMax = 5;
+
+    inline int Thickness(float value)
+    {
+        int thickness = static_cast<int>(value + 0.5f);
+
+        if (thickness < kThicknessMin)
+            return kThicknessMin;
+
+        return thickness > kThicknessMax ? kThicknessMax : thickness;
+    }
+
+    // Where a line of the given thickness starts relative to the screen center line, so the
+    // extra pixels split evenly around it; the one-pixel line stays where it always was.
+    inline int ThicknessOffset(int thickness)
+    {
+        return -(thickness - 1) / 2;
+    }
+
     // Dynamic spread of the rifles: the gap at rest, the speed past which running widens
     // it, and by how much.
     inline constexpr int kRifleGap = 4;
diff --git a/nextclient/packages/gameplay/crosshair/tests/CrosshairTests.cpp b/nextclient/packages/gameplay/crosshair/tests/CrosshairTests.cpp
index 00f8f96..631eb74 100644
--- a/nextclient/packages/gameplay/crosshair/tests/CrosshairTests.cpp
+++ b/nextclient/packages/gameplay/crosshair/tests/CrosshairTests.cpp
@@ -59,3 +59,20 @@ TEST(CrosshairSpread, BarGrowsWithTheOpenedGapAndScalesToTheScreen)
     EXPECT_EQ(crosshair::ScaledBarSize(5, 1920, 640), 15);
     EXPECT_EQ(crosshair::ScaledBarSize(5, 640, 640), 5);
 }
+
+TEST(CrosshairThickness, RoundsAndStaysWithinBounds)
+{
+    EXPECT_EQ(crosshair::Thickness(1.0f), 1);
+    EXPECT_EQ(crosshair::Thickness(2.6f), 3);
+    EXPECT_EQ(crosshair::Thickness(0.0f), crosshair::kThicknessMin);
+    EXPECT_EQ(crosshair::Thickness(-3.0f), crosshair::kThicknessMin);
+    EXPECT_EQ(crosshair::Thickness(40.0f), crosshair::kThicknessMax);
+}
+
+TEST(CrosshairThickness, SplitsExtraPixelsAroundTheCenterLine)
+{
+    EXPECT_EQ(crosshair::ThicknessOffset(1), 0);
+    EXPECT_EQ(crosshair::ThicknessOffset(2), 0);
+    EXPECT_EQ(crosshair::ThicknessOffset(3), -1);
+    EXPECT_EQ(crosshair::ThicknessOffset(5), -2);
+}
