// X CLIENT launcher ikonkasi (xclient_launcher.c: LoadIconW(hi, MAKEINTRESOURCEW(1)))
1 ICON "xclient.ico"

// exe xususiyatlari (kompaniya, nom, versiya) va manifest: antiviruslar ma'lumotsiz, noma'lum exe larga ko'proq shubha qiladi
#include <winver.h>
#include "xc_ver.h"
1 24 "xclient.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,XC_BUILD,0
PRODUCTVERSION 1,0,XC_BUILD,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "X CLIENT (cssborka.uz)"
            VALUE "FileDescription", "X CLIENT - Counter-Strike 1.6 launcher"
            VALUE "FileVersion", XC_VERSTR
            VALUE "InternalName", "XCLauncher"
            VALUE "LegalCopyright", "X CLIENT, cssborka.uz"
            VALUE "OriginalFilename", "XCLauncher.exe"
            VALUE "ProductName", "X CLIENT"
            VALUE "ProductVersion", XC_VERSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
